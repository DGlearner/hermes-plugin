  {
    "name": "finalize_direct_knowledge_upload",
    "description": "After the employee-local PUT commands complete, ask the service to verify the exact OSS objects and queue only valid files for ingestion. Omit files to finalize every remaining file, or pass file IDs with optional ETag/CRC64 observations. The operation is safe to retry and never accepts an object URL.",
    "input_schema": {
      "$defs": {
        "DirectUploadFinalizeFile": {
          "additionalProperties": false,
          "properties": {
            "file_id": {
              "format": "uuid",
              "title": "File Id",
              "type": "string"
            },
            "etag": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Etag"
            },
            "crc64": {
              "anyOf": [
                {
                  "pattern": "^[0-9]{1,20}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Crc64"
            }
          },
          "required": [
            "file_id"
          ],
          "title": "DirectUploadFinalizeFile",
          "type": "object"
        }
      },
      "properties": {
        "upload_id": {
          "format": "uuid",
          "title": "Upload Id",
          "type": "string"
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DirectUploadFinalizeFile"
          },
          "title": "Files",
          "type": "array"
        }
      },
      "required": [
        "upload_id"
      ],
      "title": "finalize_direct_knowledge_uploadArguments",
      "type": "object"
    }
  },
